# Copy this file to .env and adjust as needed. Nothing here is required;
# every value has a sane default and the app runs fine with no .env at all.

# HTTP port the server listens on.
#PORT=5000

# Run the capture browser with a visible window instead of headless. Use 0
# once if Scribd's bot challenge won't clear on its own; after that the
# profile in PROFILE_DIR remembers it and headless works again.
#HEADLESS=1

# Force a specific installed browser instead of auto-detecting Chrome, then
# Edge. Or point SCRIBD_DL_EXECUTABLE at a Chromium-based binary directly.
#SCRIBD_DL_CHANNEL=chrome
#SCRIBD_DL_EXECUTABLE=

# How long to wait for a document to finish rendering, in seconds.
#CAPTURE_TIMEOUT_SECONDS=120

# Where rendered documents and the browser profile are stored. Handy to
# point at a persistent volume if this ever runs in a container.
#CACHE_DIR=cache
#PROFILE_DIR=.profile

# Default age (in hours) POST /admin/cleanup removes cached documents past,
# when the request doesn't pass its own ?maxAgeHours=.
#CLEANUP_MAX_AGE_HOURS=24

# If set, POST /admin/cleanup requires this value back as ?token= or an
# X-Cleanup-Token header. Worth setting if this server is ever reachable by
# anything other than your own cron.
#CLEANUP_TOKEN=
